PORT=5000
DB_URL=postgres://user:password@host:port/database?sslmode=require
ALLOWED_ORIGIN=*

# Paystack — get keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin password for protected actions (change this!)
ADMIN_SECRET=your-secure-secret-here

# Subscription Plans (KES, whole units)
# Adjust these to change pricing without redeploying
PLAN_DAILY_PRICE=100
PLAN_WEEKLY_PRICE=600
PLAN_MONTHLY_PRICE=2000
PLAN_LIFETIME_PRICE=10000
